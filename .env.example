# Copy to `.env.local` for local development. On Vercel, set the same
# variables in Project → Settings → Environment Variables.

# Public URL of the site (no trailing slash). Used for SEO, sitemap and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (public) -------------------------------------------------------
# From sanity.io/manage. Without a project id the site uses its built-in
# placeholder content and the forms run in demo mode.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# `production` for the live site, `development` for previews and local work.
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# --- Sanity (secret, server only) ------------------------------------------
# Token with "Editor" rights, used to save form submissions in the Studio.
SANITY_API_WRITE_TOKEN=
# Random string shared with the Sanity webhook that refreshes the site.
SANITY_REVALIDATE_SECRET=

# --- Payments ----------------------------------------------------------------
# Only `mock` (demo, nothing is charged) exists today. See BACKLOG.md.
PAYMENT_PROVIDER=mock
