{
  "name": "associazione-bledi-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "sanity": "sanity",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.10.1",
    "@portabletext/react": "8.0.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.22.0",
    "adhan": "^4.4.6",
    "lucide-react": "^1.70.0",
    "negotiator": "^1.1.0",
    "next": "16.4.5",
    "next-sanity": "13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.22.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
